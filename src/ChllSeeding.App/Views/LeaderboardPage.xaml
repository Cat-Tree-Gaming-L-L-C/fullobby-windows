<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ChllSeeding.App.Views.LeaderboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ChllSeeding.App.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
        <StackPanel Spacing="10">

            <!-- Header + period selector -->
            <Grid>
                <TextBlock
                    Text="{x:Bind ViewModel.PeriodLabel, Mode=OneWay}"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                    <Button Content="Day" Command="{x:Bind ViewModel.SetPeriodCommand}" CommandParameter="1" />
                    <Button Content="Week" Command="{x:Bind ViewModel.SetPeriodCommand}" CommandParameter="7" />
                    <Button Content="Month" Command="{x:Bind ViewModel.SetPeriodCommand}" CommandParameter="30" />
                    <Button Content="All" Command="{x:Bind ViewModel.SetPeriodCommand}" CommandParameter="3650" />
                </StackPanel>
            </Grid>

            <!-- My Stats card (signed-in only) -->
            <Border
                Visibility="{x:Bind ViewModel.ShowMyStats, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="8"
                Padding="12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="My Stats" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ProgressRing
                            Width="16" Height="16"
                            IsActive="True"
                            Visibility="{x:Bind ViewModel.MyStatsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <Grid
                        ColumnSpacing="8"
                        Visibility="{x:Bind ViewModel.HasMyStats, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Total Time" FontSize="11" Opacity="0.6" />
                                <TextBlock Text="{x:Bind ViewModel.MyStatsTotalTime, Mode=OneWay}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Sessions" FontSize="11" Opacity="0.6" />
                                <TextBlock Text="{x:Bind ViewModel.MyStatsSessions, Mode=OneWay}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Avg Session" FontSize="11" Opacity="0.6" />
                                <TextBlock Text="{x:Bind ViewModel.MyStatsAvgSession, Mode=OneWay}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Per-server breakdown -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.MyServers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServerStatRow">
                                <Grid Margin="0,1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ServerName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Time}" FontSize="12" Width="64" TextAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Sessions}" FontSize="12" Width="36" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Recent sessions -->
                    <TextBlock
                        Text="Recent Sessions"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Visibility="{x:Bind ViewModel.HasMyStats, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.MyRecentSessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentSessionRow">
                                <Grid Margin="0,1" ColumnSpacing="8" Padding="6,2" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ServerName}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Border Grid.Column="1"
                                            Background="{x:Bind Status, Converter={StaticResource SessionStatusToBrush}}"
                                            CornerRadius="4" Padding="6,1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind Status}" FontSize="10" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Duration}" FontSize="12" Width="56" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Loading -->
            <StackPanel
                Spacing="6"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"
                Visibility="{x:Bind ViewModel.Loading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressRing IsActive="True" Width="28" Height="28" HorizontalAlignment="Center" />
                <TextBlock Text="Loading leaderboard…" Opacity="0.7" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Error -->
            <StackPanel
                Spacing="6"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
                <HyperlinkButton Content="Tap to retry" HorizontalAlignment="Center" Command="{x:Bind ViewModel.RefreshCommand}" />
            </StackPanel>

            <!-- Empty -->
            <TextBlock
                Text="No seeding data for this period."
                Opacity="0.7"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <!-- Rankings table -->
            <StackPanel Spacing="0">
                <Grid Padding="8,4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" FontSize="11" Opacity="0.6" />
                    <TextBlock Grid.Column="1" Text="Seeder" FontSize="11" Opacity="0.6" />
                    <TextBlock Grid.Column="2" Text="Time" FontSize="11" Opacity="0.6" Width="64" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Sessions" FontSize="11" Opacity="0.6" Width="64" TextAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LeaderboardRow">
                            <Grid Padding="8,4" Margin="0,1" ColumnSpacing="8" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Rank}"
                                           Foreground="{x:Bind Rank, Converter={StaticResource RankToBrush}}"
                                           FontWeight="{x:Bind Rank, Converter={StaticResource RankToWeight}}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Username}" TextTrimming="CharacterEllipsis"
                                           Foreground="{x:Bind Rank, Converter={StaticResource RankToBrush}}"
                                           FontWeight="{x:Bind Rank, Converter={StaticResource RankToWeight}}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Time}" Width="64" TextAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Sessions}" Width="64" TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
