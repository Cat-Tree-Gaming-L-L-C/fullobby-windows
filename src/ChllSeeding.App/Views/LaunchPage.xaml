<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ChllSeeding.App.Views.LaunchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ChllSeeding.App.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
        <StackPanel Spacing="8">

            <!-- Status banner (shared seeding lifecycle) -->
            <Border
                Visibility="{x:Bind ViewModel.ShowStatusBanner, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="6"
                Padding="12,6">
                <TextBlock
                    Text="{x:Bind ViewModel.StatusBanner, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center" />
            </Border>

            <!-- Error banner (Launch-page scoped; does not bleed onto other pages) -->
            <Border
                Visibility="{x:Bind ViewModel.ShowLaunchError, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                CornerRadius="6"
                Padding="12,6">
                <TextBlock
                    Text="{x:Bind ViewModel.LaunchError, Mode=OneWay}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center" />
            </Border>

            <!-- Loading / retry state -->
            <StackPanel
                Spacing="6"
                HorizontalAlignment="Center"
                Visibility="{x:Bind ViewModel.ServersReady, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <ProgressRing
                    IsActive="True"
                    Width="28" Height="28"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.ServerLoadError, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                <TextBlock
                    Text="Loading servers…"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.ServerLoadError, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                <TextBlock
                    Text="Failed to load servers."
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.ServerLoadError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <HyperlinkButton
                    Content="Tap to retry"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.RetryServersCommand}"
                    Visibility="{x:Bind ViewModel.ServerLoadError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- Launch buttons (idle states) -->
            <StackPanel
                Spacing="6"
                Visibility="{x:Bind ViewModel.ShowSeedButtons, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                <TextBlock
                    Text="NA"
                    FontSize="12"
                    Opacity="0.7"
                    Visibility="{x:Bind ViewModel.EuEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.NaServers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerRow">
                            <StackPanel Margin="0,2" Spacing="2">
                                <Button
                                    Content="{x:Bind LaunchLabel}"
                                    Height="44"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    IsEnabled="{x:Bind CanLaunch, Mode=OneWay}"
                                    Click="OnLaunchClick" />
                                <TextBlock
                                    Text="{x:Bind LaunchBlockedReason, Mode=OneWay}"
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    HorizontalAlignment="Center"
                                    Visibility="{x:Bind CanLaunch, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Text="EU"
                    FontSize="12"
                    Opacity="0.7"
                    Visibility="{x:Bind ViewModel.EuEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <ItemsControl
                    ItemsSource="{x:Bind ViewModel.EuServers}"
                    Visibility="{x:Bind ViewModel.EuEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerRow">
                            <StackPanel Margin="0,2" Spacing="2" Opacity="0.85">
                                <Button
                                    Content="{x:Bind LaunchLabel}"
                                    Height="44"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    IsEnabled="{x:Bind CanLaunch, Mode=OneWay}"
                                    Click="OnLaunchClick" />
                                <TextBlock
                                    Text="{x:Bind LaunchBlockedReason, Mode=OneWay}"
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    HorizontalAlignment="Center"
                                    Visibility="{x:Bind CanLaunch, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Active states: stop controls -->
            <Grid
                ColumnSpacing="8"
                Margin="0,8,0,0"
                Visibility="{x:Bind ViewModel.ShowActiveSeeding, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Content="Stop Seeding"
                    Height="56"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    IsEnabled="{x:Bind ViewModel.IsSeeding, Mode=OneWay}"
                    Command="{x:Bind ViewModel.StopSeedingOnlyCommand}" />
                <Button
                    Grid.Column="1"
                    Content="Stop Game"
                    Height="56"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{x:Bind ViewModel.StopGameCommand}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
