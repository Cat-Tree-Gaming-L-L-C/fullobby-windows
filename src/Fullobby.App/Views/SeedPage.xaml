<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fullobby.App.Views.SeedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Fullobby.App.ViewModels">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel Spacing="8">

                <!-- Live-feed connectivity indicator + manual reconnect (stats still poll over HTTP
                     while the SSE stream is down). Port of the seed_banner Live dot + reconnect_button. -->
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <Ellipse
                        Width="8" Height="8"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource SystemFillColorSuccessBrush}"
                        Visibility="{x:Bind ViewModel.SseConnected, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ConnectionStatusText, Mode=OneWay}"
                        FontSize="11"
                        Opacity="0.7"
                        VerticalAlignment="Center" />
                    <HyperlinkButton
                        Content="Reconnect"
                        FontSize="11"
                        Padding="4,0"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.ReconnectCommand}"
                        Visibility="{x:Bind ViewModel.ShowReconnect, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Status banner (shared seeding lifecycle) -->
                <Border
                    Visibility="{x:Bind ViewModel.ShowStatusBanner, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                    CornerRadius="6"
                    Padding="12,6">
                    <TextBlock
                        Text="{x:Bind ViewModel.StatusBanner, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center" />
                </Border>

                <!-- Error banner (Seed-page scoped; does not bleed onto other pages) -->
                <Border
                    Visibility="{x:Bind ViewModel.ShowSeedError, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    CornerRadius="6"
                    Padding="12,6">
                    <TextBlock
                        Text="{x:Bind ViewModel.SeedError, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center" />
                </Border>

                <!-- Splash-bypass banner -->
                <Border
                    Visibility="{x:Bind ViewModel.SplashBypassActive, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                    CornerRadius="6"
                    Padding="12,4">
                    <TextBlock
                        Text="{x:Bind ViewModel.SplashBypassText, Mode=OneWay}"
                        FontSize="12"
                        TextAlignment="Center"
                        HorizontalAlignment="Center" />
                </Border>

                <!-- Loading / retry state -->
                <StackPanel
                    Spacing="6"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.ServersReady, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <ProgressRing
                        IsActive="True"
                        Width="28" Height="28"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.ServerLoadError, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <TextBlock
                        Text="Loading servers…"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.ServerLoadError, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <TextBlock
                        Text="Failed to load servers."
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.ServerLoadError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <HyperlinkButton
                        Content="Tap to retry"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.RetryServersCommand}"
                        Visibility="{x:Bind ViewModel.ServerLoadError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Server stats list (single ordered rotation; the server decides what to seed) -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Servers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerRow">
                            <StackPanel>
                            <!-- Network group header (only when more than one network has servers) -->
                            <TextBlock
                                Text="{x:Bind NetworkHeader, Mode=OneWay}"
                                Visibility="{x:Bind ShowNetworkHeader, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Opacity="0.6"
                                Margin="2,8,0,2" />
                            <Border
                                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                CornerRadius="6"
                                Padding="10,4"
                                Margin="0,2">
                                <!-- Grid, not a horizontal StackPanel: a StackPanel measures its
                                     first child at infinite width, so a long "name — map — n/N"
                                     line consumes the row and pushes the badges past the right
                                     edge (the ScrollViewer doesn't scroll horizontally). The
                                     Passworded badge is precisely what explains why a server is
                                     never seeded, so it must not be the first thing to disappear. -->
                                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind StatsLine, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind StatsLine, Mode=OneWay}"
                                        FontSize="12"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        VerticalAlignment="Center" />
                                    <Border
                                        Grid.Column="1"
                                        Visibility="{x:Bind IsPassworded, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Password-protected — excluded from seeding (HLL can't join a passworded server via the launcher)">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE72E;" FontSize="11" />
                                            <TextBlock Text="Passworded" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Today's ready standing (ready-check / seeded state) -->
                                    <Border
                                        Grid.Column="2"
                                        Visibility="{x:Bind ShowReadyBadge, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                        Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ReadyBadge, Mode=OneWay}" FontSize="11" />
                                    </Border>
                                </Grid>
                            </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Seed button (idle states). Efficiency-capable games get a split button: the
                     primary click seeds with the game's remembered Power Savings choice (zero
                     friction), the flyout offers the explicit pair (each click persisted as the
                     new remembered default). Other games keep a plain button. The second line
                     names the game a seed starts: the server picks it across installed games. -->
                <StackPanel
                    Spacing="8"
                    Margin="0,8,0,0"
                    Visibility="{x:Bind ViewModel.ShowSeedButtons, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <SplitButton
                        Height="56"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{x:Bind ViewModel.SeedCommand}"
                        Visibility="{x:Bind ViewModel.ShowEfficiencyOption, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Seed" HorizontalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind ViewModel.SeedGameLabel, Mode=OneWay}"
                                FontSize="11"
                                Opacity="0.75"
                                HorizontalAlignment="Center" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem
                                    Text="Seed Now (no power savings)"
                                    Command="{x:Bind ViewModel.SeedWithChoiceCommand}"
                                    CommandParameter="false" />
                                <MenuFlyoutItem
                                    Text="Seed with Power Savings"
                                    Command="{x:Bind ViewModel.SeedWithChoiceCommand}"
                                    CommandParameter="true"
                                    ToolTipService.ToolTip="Temporarily edits the game's GameUserSettings.ini to apply low-resource settings while seeding. Your original settings are backed up and restored when seeding ends." />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button
                        Height="56"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SeedCommand}"
                        Visibility="{x:Bind ViewModel.ShowEfficiencyOption, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Seed" HorizontalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind ViewModel.SeedGameLabel, Mode=OneWay}"
                                FontSize="11"
                                Opacity="0.75"
                                HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Waiting for update: cancel -->
                <Button
                    Content="Cancel"
                    Height="56"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{x:Bind ViewModel.StopGameCommand}"
                    Visibility="{x:Bind ViewModel.ShowWaitingForUpdate, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <!-- Active seeding: stop controls -->
                <Grid
                    ColumnSpacing="8"
                    Margin="0,8,0,0"
                    Visibility="{x:Bind ViewModel.ShowActiveSeeding, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Content="Stop Seeding"
                        Height="56"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.CanStopSeedingOnly, Mode=OneWay}"
                        Command="{x:Bind ViewModel.StopSeedingOnlyCommand}" />
                    <Button
                        Grid.Column="1"
                        Content="Stop Game"
                        Height="56"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{x:Bind ViewModel.StopGameCommand}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Server-switch overlay -->
        <Grid
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Visibility="{x:Bind ViewModel.ServerSwitchActive, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Border
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                CornerRadius="8"
                Padding="20"
                Margin="24"
                VerticalAlignment="Center">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind ViewModel.ServerSwitchHeading, Mode=OneWay}"
                        FontWeight="SemiBold"
                        FontSize="16"
                        HorizontalAlignment="Center" />
                    <!-- Wraps: during a forced switch this is the only thing telling the user
                         which server they are being moved to, and server names are long. -->
                    <TextBlock
                        Text="{x:Bind ViewModel.ServerSwitchServerName, Mode=OneWay}"
                        Opacity="0.8"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ServerSwitchDetail, Mode=OneWay}"
                        Opacity="0.7"
                        FontSize="12"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ServerSwitchCountdownText, Mode=OneWay}"
                        FontFamily="Consolas"
                        FontSize="32"
                        HorizontalAlignment="Center" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.ServerSwitchSnoozed, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <Button Content="+5 min" Command="{x:Bind ViewModel.SnoozeCommand}" CommandParameter="300" />
                        <Button Content="+15 min" Command="{x:Bind ViewModel.SnoozeCommand}" CommandParameter="900" />
                        <Button Content="+30 min" Command="{x:Bind ViewModel.SnoozeCommand}" CommandParameter="1800" />
                    </StackPanel>
                    <Button
                        Content="Switch Now"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.SwitchNowCommand}" />
                    <Button
                        Content="Stop Seeding"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.StopSeedingOnlyCommand}"
                        Visibility="{x:Bind ViewModel.EfficiencyMode, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Auto-seed "Seed now?" prompt (scheduled / missed-task triggered): the countdown overlay
             styled as a confirm dialog. An explicit answer starts immediately and persists the
             Power Savings choice per game; on timeout the remembered preference applies unchanged
             (unattended auto-seed), and Cancel aborts as before. -->
        <Grid
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Visibility="{x:Bind ViewModel.AutoseedCountdownActive, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Border
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                CornerRadius="8"
                Padding="20"
                Margin="24"
                VerticalAlignment="Center">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock
                        Text="Seed now?"
                        FontWeight="SemiBold"
                        FontSize="16"
                        HorizontalAlignment="Center" />
                    <!-- Game + target server (best-effort preview; game-only until the fetch lands) -->
                    <TextBlock
                        Text="{x:Bind ViewModel.AutoseedPromptContext, Mode=OneWay}"
                        Opacity="0.8"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center" />
                    <!-- A game is already open: say what Seed Now will close. Unanswered, it's left alone. -->
                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        MaxWidth="320"
                        Message="{x:Bind ViewModel.AutoseedSwapNotice, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowAutoseedSwapNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.AutoseedCountdownText, Mode=OneWay}"
                        Opacity="0.7"
                        FontSize="12"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center" />
                    <StackPanel Spacing="6" MinWidth="260">
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.AutoseedChooseCommand}"
                            CommandParameter="false">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Seed Now" HorizontalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.SeedGameLabel, Mode=OneWay}"
                                    FontSize="11"
                                    Opacity="0.75"
                                    HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{x:Bind ViewModel.AutoseedChooseCommand}"
                            CommandParameter="true"
                            Visibility="{x:Bind ViewModel.ShowEfficiencyOption, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            ToolTipService.ToolTip="Temporarily edits the game's GameUserSettings.ini to apply low-resource settings while seeding. Your original settings are backed up and restored when seeding ends.">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Seed with Power Savings" HorizontalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.SeedGameLabel, Mode=OneWay}"
                                    FontSize="11"
                                    Opacity="0.75"
                                    HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            Content="Cancel"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{x:Bind ViewModel.CancelAutoseedCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
