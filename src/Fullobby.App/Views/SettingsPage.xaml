<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fullobby.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Fullobby.App.ViewModels">

    <!-- Layout contract for this page: every row that pairs a label with a control is a two-column
         Grid (* for the text, Auto for the control). A single-cell Grid with a right-aligned button
         renders the button *on top of* the label, which silently hides dynamic strings (provider
         handles, network names, schtasks timestamps, versions) behind the control. The window is a
         fixed 500px wide and non-resizable, so there is no user recovery from an overlap — the
         constraint has to be expressed in the layout. Text columns wrap or ellipsize; anything
         ellipsized carries a ToolTip so the full value stays reachable. -->
    <ScrollViewer Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="6" HorizontalAlignment="Stretch">

            <!-- ── Account ─────────────────────────────────────────────── -->
            <TextBlock
                Text="Account"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.HeadingLevel="Level2" />

            <ProgressRing
                IsActive="True" Width="20" Height="20" HorizontalAlignment="Center" Margin="0,4"
                Visibility="{x:Bind Account.AuthLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <!-- Signed in -->
            <StackPanel
                Spacing="6"
                Visibility="{x:Bind Account.IsLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <!-- Name on its own row so it can use the full width; actions sit below. -->
                <TextBlock
                    Text="{x:Bind Account.DisplayName, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Account.DisplayName, Mode=OneWay}"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        Content="Rotate API Key"
                        Command="{x:Bind Account.RotateApiKeyCommand}"
                        Visibility="{x:Bind Account.CanRotateApiKey, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Sign Out" Command="{x:Bind Account.SignOutCommand}" />
                </StackPanel>

                <!-- Linked providers -->
                <TextBlock
                    Text="Linked Providers"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="0,4,0,0"
                    Visibility="{x:Bind Account.HasLinkedProviders, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{x:Bind Account.LinkedProviders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LinkedProviderRow">
                            <!-- Label is "Provider (handle)" — a long handle must ellipsize in its
                                 own column, never slide under the Unlink button. -->
                            <Grid Padding="6,2" Margin="0,1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind Label}"
                                    ToolTipService.ToolTip="{x:Bind Label}"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="1"
                                    Content="Unlink"
                                    Tag="{x:Bind Provider}"
                                    Click="Unlink_Click"
                                    Visibility="{x:Bind CanUnlink, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Link buttons -->
                <StackPanel Spacing="4" Margin="0,2" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <Button
                            Content="Link Steam"
                            Command="{x:Bind Account.LinkProviderCommand}"
                            CommandParameter="steam"
                            Visibility="{x:Bind Account.SteamLinked, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <Button
                            Content="Link Discord"
                            Command="{x:Bind Account.LinkProviderCommand}"
                            CommandParameter="discord"
                            Visibility="{x:Bind Account.HasDiscordProvider, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                    <!-- Not live yet: exposed but disabled. To turn one on, drop its
                         IsEnabled="False" and add the provider to ApiValidation.ValidProviders. -->
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <Button Content="Link Epic Games" IsEnabled="False" Command="{x:Bind Account.LinkProviderCommand}" CommandParameter="epic" />
                        <Button Content="Link Xbox" IsEnabled="False" Command="{x:Bind Account.LinkProviderCommand}" CommandParameter="microsoft" />
                    </StackPanel>
                    <TextBlock
                        Text="Epic Games and Xbox linking is coming soon."
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Irreversible: kept off the row that holds Sign Out so a mis-click can't land
                     on it, and labelled with its consequence rather than sitting bare. -->
                <StackPanel Spacing="2" Margin="0,10,0,0">
                    <Button Content="Delete Account" Click="DeleteAccount_Click" HorizontalAlignment="Left" />
                    <TextBlock
                        Text="Permanently deletes your account and all seeding history."
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <!-- Signed out: sign-in options -->
            <StackPanel
                Spacing="6"
                Visibility="{x:Bind Account.IsLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Sign in with Steam" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Account.LoginCommand}" CommandParameter="steam" />
                    <Button Content="Sign in with Discord" Command="{x:Bind Account.LoginCommand}" CommandParameter="discord" />
                </StackPanel>
                <!-- Not live yet: exposed but disabled. To turn one on, drop its
                     IsEnabled="False" and add the provider to ApiValidation.ValidProviders. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Sign in with Epic Games" IsEnabled="False" Command="{x:Bind Account.LoginCommand}" CommandParameter="epic" />
                    <Button Content="Sign in with Xbox" IsEnabled="False" Command="{x:Bind Account.LoginCommand}" CommandParameter="microsoft" />
                </StackPanel>
                <TextBlock
                    Text="Epic Games and Xbox sign-in are coming soon."
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- ── Player ──────────────────────────────────────────────── -->
            <TextBlock
                Text="Player"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.HeadingLevel="Level2"
                Margin="0,8,0,0" />

            <Button
                Content="{x:Bind Account.NameButtonText, Mode=OneWay}"
                HorizontalAlignment="Left"
                IsEnabled="{x:Bind Account.IsLoggedIn, Mode=OneWay}"
                Click="ChangeName_Click" />
            <TextBlock
                Text="Sign in to change your display name."
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Account.IsLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

            <Grid
                ColumnSpacing="12"
                Visibility="{x:Bind Account.IsLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Show on Leaderboard" TextWrapping="Wrap" />
                    <TextBlock
                        Text="Appear in public rankings"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="LeaderboardSpinner" Width="16" Height="16" IsActive="True" Visibility="Collapsed" />
                    <ToggleSwitch
                        x:Name="LeaderboardToggle"
                        AutomationProperties.Name="Show on Leaderboard"
                        Toggled="LeaderboardToggle_Toggled" />
                </StackPanel>
            </Grid>

            <!-- ── Networks ────────────────────────────────────────────── -->
            <TextBlock
                Text="Seeding Networks"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.HeadingLevel="Level2"
                Margin="0,8,0,0" />

            <StackPanel
                Spacing="4"
                Visibility="{x:Bind Account.IsLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    Text="Networks you seed with, in priority order (top = preferred)."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{x:Bind Account.Networks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NetworkMembershipRow">
                            <!-- Network names are operator-supplied and routinely long; the name
                                 column ellipsizes with a ToolTip rather than clipping mid-glyph. -->
                            <Grid Padding="6,2" Margin="0,1" ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind Label}"
                                    ToolTipService.ToolTip="{x:Bind Label}"
                                    FontSize="12"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    VerticalAlignment="Center" />
                                <Button Grid.Column="1" Padding="8,4" Tag="{x:Bind}" Click="NetworkUp_Click"
                                        AutomationProperties.Name="Raise network priority"
                                        ToolTipService.ToolTip="Higher priority">
                                    <FontIcon Glyph="&#xE70E;" FontSize="11" />
                                </Button>
                                <Button Grid.Column="2" Padding="8,4" Tag="{x:Bind}" Click="NetworkDown_Click"
                                        AutomationProperties.Name="Lower network priority"
                                        ToolTipService.ToolTip="Lower priority">
                                    <FontIcon Glyph="&#xE70D;" FontSize="11" />
                                </Button>
                                <Button Grid.Column="3" Content="Leave" Tag="{x:Bind}" Click="NetworkLeave_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Join a network" HorizontalAlignment="Left" Click="NetworkJoin_Click" />
            </StackPanel>

            <TextBlock
                Text="Sign in to manage your seeding networks."
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Account.IsLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

            <!-- ── Appearance & Behaviour ──────────────────────────────── -->
            <TextBlock
                Text="Appearance &amp; Behaviour"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.HeadingLevel="Level2"
                Margin="0,8,0,0" />

            <!-- Descriptions live in their own wrapped TextBlock, not in On/OffContent: the stock
                 ToggleSwitch template lays On/OffContent out on a single non-wrapping line beside
                 the ~52px track, so a sentence there is hard-clipped mid-word at this window width.
                 With no On/OffContent set, the switch shows the standard On/Off state labels. -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Theme" TextWrapping="Wrap" />
                    <TextBlock
                        Text="Dark is the Fullobby default"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox
                    x:Name="ThemeCombo"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    MinWidth="150"
                    AutomationProperties.Name="App theme"
                    SelectionChanged="ThemeCombo_SelectionChanged">
                    <ComboBoxItem Content="Dark" Tag="dark" />
                    <ComboBoxItem Content="Light" Tag="light" />
                    <ComboBoxItem Content="Use system setting" Tag="system" />
                </ComboBox>
            </Grid>

            <StackPanel>
                <ToggleSwitch
                    x:Name="CloseToTrayToggle"
                    Header="Minimize to tray on close"
                    Toggled="CloseToTrayToggle_Toggled" />
                <TextBlock
                    Text="When on, closing the window keeps Fullobby running in the tray. When off, closing exits the app."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Margin="0,6,0,0">
                <ToggleSwitch
                    x:Name="SwitchNotificationToggle"
                    Header="Notify before switching servers"
                    Toggled="SwitchNotificationToggle_Toggled" />
                <TextBlock
                    Text="When on, you get a 30-second countdown and a desktop notification before Fullobby moves you to another server."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid Margin="0,10,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Splash Bypass Duration" TextWrapping="Wrap" />
                    <TextBlock
                        Text="How long to send keypresses to skip the intro video"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox
                    x:Name="SplashDurationCombo"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    MinWidth="110"
                    AutomationProperties.Name="Splash bypass duration"
                    SelectionChanged="SplashDurationCombo_SelectionChanged">
                    <ComboBoxItem Content="10 sec" Tag="10" />
                    <ComboBoxItem Content="20 sec" Tag="20" />
                    <ComboBoxItem Content="40 sec" Tag="40" />
                    <ComboBoxItem Content="60 sec" Tag="60" />
                </ComboBox>
            </Grid>

            <!-- ── Automation ──────────────────────────────────────────── -->
            <TextBlock
                Text="Automation"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.HeadingLevel="Level2"
                Margin="0,8,0,0" />

            <StackPanel>
                <ToggleSwitch
                    x:Name="StartupToggle"
                    Header="Start with Windows"
                    Toggled="StartupToggle_Toggled" />
                <TextBlock
                    Text="When on, Fullobby launches automatically at sign-in."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="Auto-Seed" Margin="0,10,0,0" TextWrapping="Wrap" />
            <TextBlock
                Text="Seed automatically once a day. The wake time follows the server's seeding schedule (UTC); your PC wakes from sleep to seed."
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <!-- Daily auto-seed (single task; the server decides what to seed).
                 AutoseedStatus carries a locale-formatted next-run timestamp once the task exists —
                 the longest dynamic string on this page, so it gets the wrapping * column. -->
            <Grid Margin="0,2,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Daily auto-seed" TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="AutoseedStatus"
                        Text="Not scheduled"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ProgressRing x:Name="AutoseedSpinner" Width="16" Height="16" IsActive="True" Visibility="Collapsed" />
                    <Button x:Name="AutoseedSetup" Content="Set up" Click="AutoseedSetup_Click" />
                    <Button x:Name="AutoseedRemove" Content="Remove" Visibility="Collapsed" Click="AutoseedRemove_Click" />
                </StackPanel>
            </Grid>

            <!-- ── Updates ─────────────────────────────────────────────── -->
            <TextBlock
                Text="Updates"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.HeadingLevel="Level2"
                Margin="0,8,0,0" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="App Updates" TextWrapping="Wrap" />
                    <!-- Carries a full SemVer, including pre-release suffixes on the beta channel. -->
                    <TextBlock
                        x:Name="UpdateStatus"
                        Text="Check for the latest version"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="UpdateSpinner" Width="16" Height="16" IsActive="True" Visibility="Collapsed" />
                    <Button x:Name="CheckUpdatesButton" Content="Check for Updates" Click="CheckUpdates_Click" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,6,0,0">
                <ToggleSwitch
                    x:Name="BetaToggle"
                    Header="Beta Updates"
                    Toggled="BetaToggle_Toggled" />
                <TextBlock
                    Text="When on, pre-release builds are offered alongside stable ones."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
