<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fullobby.App.Views.AdminPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- The embedded web admin panel (signed in via a one-time code from the
             app session). Kept as the single admin surface alongside the DM
             console — no third UI to keep in parity. -->
        <WebView2 x:Name="PanelView" Visibility="Collapsed" />

        <StackPanel
            x:Name="StatusPanel"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            MaxWidth="360">
            <ProgressRing x:Name="Spinner" IsActive="True" Width="28" Height="28" />
            <TextBlock
                x:Name="StatusText"
                Text="Signing in to the admin panel…"
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button
                x:Name="RetryButton"
                Content="Try again"
                HorizontalAlignment="Center"
                Visibility="Collapsed"
                Click="Retry_Click" />
        </StackPanel>
    </Grid>
</Page>
