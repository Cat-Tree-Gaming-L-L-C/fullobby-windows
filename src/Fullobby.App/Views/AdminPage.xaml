<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fullobby.App.Views.AdminPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- The web panel opens in the browser and signs in there, not from the app's
             session (see the code-behind). Still the single admin surface alongside the
             DM console: no third UI to keep in parity. -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            MaxWidth="400">
            <TextBlock
                Text="Manage"
                Style="{StaticResource SubtitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="The management panel opens in your browser. Sign in there with the account you use in this app."
                TextWrapping="Wrap"
                TextAlignment="Center" />
            <Button
                Content="Open the panel"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Click="Open_Click" />
            <TextBlock
                x:Name="ErrorText"
                Visibility="Collapsed"
                TextWrapping="Wrap"
                TextAlignment="Center"
                IsTextSelectionEnabled="True"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>
    </Grid>
</Page>
