<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Fullobby.App.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ScrollViewer to match every other page: the window is a fixed, non-resizable 600px tall,
         so without one the bottom of this page is unreachable at 125%+ text scaling. -->
    <ScrollViewer Padding="24,16" VerticalScrollBarVisibility="Auto">
    <Grid>
        <!-- ── Main tools menu ─────────────────────────────────────────── -->
        <StackPanel x:Name="MainMenu" Spacing="10" MaxWidth="460" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <TextBlock Text="Tools" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Back up and restore your Hell Let Loose graphics/config settings, or open the app logs."
                FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,4" />

            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Height="64" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Click="BackupSettings_Click">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE74E;" />
                        <TextBlock Text="Backup Settings" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="1" Height="64" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Click="RestoreManual_Click">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE777;" />
                        <TextBlock Text="Restore Manual" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="2" Height="64" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Click="RestoreAuto_Click">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE895;" />
                        <TextBlock Text="Restore Auto" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="0" Height="64" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Click="ViewLogs_Click">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8A5;" />
                        <TextBlock Text="View Logs" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="64" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Click="ShowLinks_Click">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE71B;" />
                        <TextBlock Text="Links &amp; Resources" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- ── Links submenu ───────────────────────────────────────────── -->
        <StackPanel x:Name="LinksMenu" Spacing="8" MaxWidth="460" HorizontalAlignment="Stretch"
                    VerticalAlignment="Top" Visibility="Collapsed">
            <HyperlinkButton Click="BackToTools_Click" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Back to Tools" />
                </StackPanel>
            </HyperlinkButton>
            <TextBlock Text="Web Resources" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Button Content="🏠  Home Page" Tag="{x:Bind WebsiteUrl}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Click="OpenLink_Click" />
            <Button Content="❓  FAQ" Tag="{x:Bind FaqUrl}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Click="OpenLink_Click" />
            <Button Content="📜  Terms and Conditions" Tag="{x:Bind TermsUrl}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OpenLink_Click" />
            <Button Content="🔒  Privacy Policy" Tag="{x:Bind PrivacyUrl}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OpenLink_Click" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
