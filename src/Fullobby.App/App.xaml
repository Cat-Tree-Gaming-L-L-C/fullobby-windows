<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Fullobby.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Fullobby.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Brand palette + azure accent ramp; merged after the controls
                     resources so its overrides win. -->
                <ResourceDictionary Source="ms-appx:///Themes/Brand.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:RankToStyleConverter x:Key="RankToStyle" />
            <converters:SessionStatusToBrushConverter x:Key="SessionStatusToBrush" />
            <converters:PeriodToStyleConverter x:Key="PeriodToStyle" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
