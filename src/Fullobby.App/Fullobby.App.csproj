<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Fullobby.App</RootNamespace>
    <AssemblyName>Fullobby</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\icons\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged deployment: Inno Setup installer, no MSIX -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Custom Program.Main handles AppInstance single-instancing before XAML starts -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- MVVMTK0045: field-based [ObservableProperty] is not AOT-safe in WinRT; we don't ship AOT.
         Partial-property form needs LangVersion=preview — revisit on the .NET 10 bump. -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.16" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260508005" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fullobby.Core\Fullobby.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\icons\icon.ico" Link="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Brand mark: logo_no_text = wordless icon glyph (titlebar/About/onboarding).
         The About wordmark is typeset text (Bebas Neue), so no branded raster ships. -->
    <Content Include="..\..\assets\logo_no_text.png" Link="Assets\logo_no_text.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Brand fonts (SIL OFL): Bebas Neue = display/wordmark, Inter = body/UI.
         The OFL.txt licenses ship alongside the .ttf files so they're carried into
         the publish output (and thus the installer) — OFL requires redistributing
         the license with the font. -->
    <Content Include="..\..\assets\fonts\BebasNeue-Regular.ttf" Link="Assets\fonts\BebasNeue-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\Inter-VariableFont.ttf" Link="Assets\fonts\Inter-VariableFont.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\BebasNeue-OFL.txt" Link="Assets\fonts\BebasNeue-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\Inter-OFL.txt" Link="Assets\fonts\Inter-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
