<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fullobby.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:services="using:Fullobby.App.Services"
    xmlns:views="using:Fullobby.App.Views">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <!-- Join-a-network banner. Its own Auto row for the same reason as the toast stack
                 below: overlaying the content would cover SeedPage's bottom buttons. -->
            <RowDefinition Height="Auto" />
            <!-- Toast stack gets its own row rather than overlaying the content. Anchored over
                 the page it sat directly on top of SeedPage's bottom Seed / Stop Seeding buttons
                 and, being hit-test visible, swallowed the click — the user saw the button, hit
                 it, and nothing happened. In its own Auto row it takes zero space when empty. -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- System tray icon: lives in the shell so it can hide/show this window.
             Menu items: Show / Restart / Quit.
             NOTE: the menu items bind Command, NOT Click. H.NotifyIcon renders the
             flyout as a native Win32 PopupMenu, which invokes attached commands but
             never raises XAML Click events (H.NotifyIcon issue #109) — Click handlers
             here silently do nothing, so the commands are wired in code-behind. -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="Fullobby"
            IconSource="ms-appx:///Assets/icon.ico"
            NoLeftClickDelay="True">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="TrayShowItem" Text="Show Window" />
                    <MenuFlyoutItem x:Name="TrayRestartItem" Text="Restart" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="TrayQuitItem" Text="Quit" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- Custom titlebar: drag region for the frameless window -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image Source="ms-appx:///Assets/logo_no_text.png" Width="18" Height="18" />
                <TextBlock
                    Text="Fullobby"
                    FontFamily="{StaticResource BrandDisplayFontFamily}"
                    FontSize="17"
                    CharacterSpacing="80"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="VersionText"
                    FontSize="11"
                    Opacity="0.5"
                    VerticalAlignment="Center" />
                <Border
                    x:Name="DevBadge"
                    Visibility="Collapsed"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    CornerRadius="4"
                    Padding="6,1"
                    VerticalAlignment="Center">
                    <TextBlock Text="DEV BUILD" FontSize="10" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            Background="Transparent"
            PaneDisplayMode="LeftCompact"
            IsPaneOpen="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="SeedNavItem" Content="Seed" Tag="seed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Launch" Tag="launch">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Ranks" Tag="leaderboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tools" Tag="tools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Admin tab: hidden unless /me reports a global Admin grant
                     (visibility driven from code-behind, like the onboarding overlay). -->
                <NavigationViewItem
                    x:Name="AdminNavItem"
                    Content="Admin"
                    Tag="admin"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7EF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Join-a-network banner: the limited-beta hard gate, shown OVER the running app rather
             than instead of it. This used to re-open the full onboarding overlay, so a configured
             user who lost a membership — often to a network being rebuilt or renamed server-side —
             had the entire shell replaced and read it as being sent back through onboarding.
             Seeding is what the gate blocks (AccountViewModel.SeedingBlocked, and the server
             refuses regardless); everything else stays reachable. Not closable: it reflects a live
             condition rather than announcing an event, and it lowers itself the moment a
             membership is confirmed. -->
        <InfoBar
            x:Name="NetworkGateBar"
            Grid.Row="2"
            IsOpen="False"
            IsClosable="False"
            Severity="Warning"
            Margin="12,0,12,6"
            Title="Join a seeding network"
            Message="Fullobby is in limited beta — seeding runs inside community networks. You won't be able to seed until you join one.">
            <InfoBar.ActionButton>
                <Button Content="Join a network" Click="NetworkGateJoin_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- In-app toast stack: occupies its own row beneath the content (see RowDefinitions). -->
        <ItemsControl
            x:Name="ToastHost"
            Grid.Row="3"
            HorizontalAlignment="Stretch"
            Margin="12,0,12,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="services:InAppToast">
                    <InfoBar
                        IsOpen="True"
                        IsClosable="True"
                        Margin="0,6,0,0"
                        Severity="{x:Bind Severity}"
                        Message="{x:Bind Message}"
                        Closed="Toast_Closed" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- First-run onboarding overlay: covers the nav shell until completed/skipped. Visibility
             is driven from code-behind (x:Bind isn't supported on a Window root).

             Occupies row 1 only, deliberately leaving both the titlebar and the toast row
             uncovered. It used to span all three rows, which hid the version string and the DEV
             BUILD badge for the whole of first run — exactly when you most want to know which build
             you are looking at, and the state a tester is in right after swapping builds — and
             swallowed every in-app toast raised at startup. The credential-protection warning is
             the one that matters: it fires before onboarding and explains why the sign-in the user
             is about to do will not stick, and it was invisible precisely when it was relevant.

             Window dragging is unaffected either way: SetTitleBar registers AppTitleBar's bounds as
             a non-client region, so caption input is resolved before XAML hit-testing and an opaque
             overlay drawn on top of it never intercepted the drag. Verified by measurement in both
             layouts before this was changed — don't "fix" it back on the assumption it matters. -->
        <views:OnboardingView
            x:Name="Onboarding"
            Grid.Row="1" />
    </Grid>
</Window>
