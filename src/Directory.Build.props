<Project>
  <PropertyGroup>
    <!-- Full SemVer including any pre-release suffix. AssemblyVersion/FileVersion drop it, so the
         updater compares InformationalVersion (see AppVersion.ForUpdateCheck) — otherwise the next
         beta would look like a downgrade from the numeric version alone. -->
    <Version>0.3.0-beta.1</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Company>Cat Tree Gaming LLC</Company>
    <Product>Fullobby</Product>
    <Copyright>© Cat Tree Gaming L.L.C.</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>
</Project>
