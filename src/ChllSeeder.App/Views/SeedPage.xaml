<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ChllSeeder.App.Views.SeedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ChllSeeder.App.ViewModels">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel Spacing="8">

                <!-- Status banner -->
                <Border
                    Visibility="{x:Bind ViewModel.ShowStatusBanner, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                    CornerRadius="6"
                    Padding="12,6">
                    <TextBlock
                        Text="{x:Bind ViewModel.StatusBanner, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center" />
                </Border>

                <!-- Splash-bypass banner -->
                <Border
                    Visibility="{x:Bind ViewModel.SplashBypassActive, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                    CornerRadius="6"
                    Padding="12,4">
                    <TextBlock
                        Text="{x:Bind ViewModel.SplashBypassText, Mode=OneWay}"
                        FontSize="12"
                        TextAlignment="Center"
                        HorizontalAlignment="Center" />
                </Border>

                <!-- Loading / retry state -->
                <StackPanel
                    Spacing="6"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.ServersReady, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <ProgressRing
                        IsActive="True"
                        Width="28" Height="28"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.ServerLoadError, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <TextBlock
                        Text="Loading servers…"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.ServerLoadError, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <TextBlock
                        Text="Failed to load servers."
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.ServerLoadError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <HyperlinkButton
                        Content="Tap to retry"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.RetryServersCommand}"
                        Visibility="{x:Bind ViewModel.ServerLoadError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- NA server stats list -->
                <TextBlock
                    Text="NA"
                    FontSize="12"
                    Opacity="0.7"
                    Margin="0,4,0,0"
                    Visibility="{x:Bind ViewModel.EuEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.NaServers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerRow">
                            <Border
                                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                CornerRadius="6"
                                Padding="10,4"
                                Margin="0,2">
                                <TextBlock Text="{x:Bind StatsLine, Mode=OneWay}" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- EU server stats list -->
                <TextBlock
                    Text="EU"
                    FontSize="12"
                    Opacity="0.7"
                    Margin="0,4,0,0"
                    Visibility="{x:Bind ViewModel.EuEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <ItemsControl
                    ItemsSource="{x:Bind ViewModel.EuServers}"
                    Visibility="{x:Bind ViewModel.EuEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerRow">
                            <Border
                                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                CornerRadius="6"
                                Padding="10,4"
                                Margin="0,2"
                                Opacity="0.85">
                                <TextBlock Text="{x:Bind StatsLine, Mode=OneWay}" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Seed buttons (idle states) -->
                <StackPanel
                    Spacing="8"
                    Margin="0,8,0,0"
                    Visibility="{x:Bind ViewModel.ShowSeedButtons, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                    <!-- EU enabled: separate NA / EU buttons -->
                    <Grid
                        ColumnSpacing="8"
                        Visibility="{x:Bind ViewModel.EuEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Content="Seed NA"
                            Height="56"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{x:Bind ViewModel.SeedNaCommand}" />
                        <Button
                            Grid.Column="1"
                            Content="Seed EU"
                            Height="56"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{x:Bind ViewModel.SeedEuCommand}" />
                    </Grid>

                    <!-- EU disabled: single Seed button -->
                    <Button
                        Content="Seed"
                        Height="56"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SeedNaCommand}"
                        Visibility="{x:Bind ViewModel.EuEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </StackPanel>

                <!-- Waiting for update: cancel -->
                <Button
                    Content="Cancel"
                    Height="56"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{x:Bind ViewModel.StopGameCommand}"
                    Visibility="{x:Bind ViewModel.ShowWaitingForUpdate, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <!-- Active seeding: stop controls -->
                <Grid
                    ColumnSpacing="8"
                    Margin="0,8,0,0"
                    Visibility="{x:Bind ViewModel.ShowActiveSeeding, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Content="Stop Seeding"
                        Height="56"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.CanStopSeedingOnly, Mode=OneWay}"
                        Command="{x:Bind ViewModel.StopSeedingOnlyCommand}" />
                    <Button
                        Grid.Column="1"
                        Content="Stop Game"
                        Height="56"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{x:Bind ViewModel.StopGameCommand}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Server-switch overlay -->
        <Grid
            Background="#B0000000"
            Visibility="{x:Bind ViewModel.ServerSwitchActive, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Border
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                CornerRadius="8"
                Padding="20"
                Margin="24"
                VerticalAlignment="Center">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind ViewModel.ServerSwitchTitle, Mode=OneWay}"
                        FontWeight="SemiBold"
                        FontSize="16"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ServerSwitchServerName, Mode=OneWay}"
                        Opacity="0.8"
                        TextAlignment="Center"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ServerSwitchCountdownText, Mode=OneWay}"
                        FontFamily="Consolas"
                        FontSize="32"
                        HorizontalAlignment="Center" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.ServerSwitchSnoozed, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <Button Content="+5 min" Command="{x:Bind ViewModel.SnoozeCommand}" CommandParameter="300" />
                        <Button Content="+15 min" Command="{x:Bind ViewModel.SnoozeCommand}" CommandParameter="900" />
                        <Button Content="+30 min" Command="{x:Bind ViewModel.SnoozeCommand}" CommandParameter="1800" />
                    </StackPanel>
                    <Button
                        Content="Switch Now"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.SwitchNowCommand}" />
                    <Button
                        Content="Stop Seeding"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.StopSeedingOnlyCommand}"
                        Visibility="{x:Bind ViewModel.EfficiencyMode, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
