<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ChllSeeder.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:services="using:ChllSeeder.App.Services"
    xmlns:views="using:ChllSeeder.App.Views">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- System tray icon: lives in the shell so it can hide/show this window.
             Menu mirrors the Rust tray (Show / Restart / Quit). -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="CHLL Seeder"
            IconSource="ms-appx:///Assets/icon.ico"
            NoLeftClickDelay="True">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Show Window" Click="TrayShow_Click" />
                    <MenuFlyoutItem Text="Restart" Click="TrayRestart_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Quit" Click="TrayQuit_Click" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- Custom titlebar: drag region for the frameless window -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image Source="ms-appx:///Assets/logo_nbg.png" Width="18" Height="18" />
                <TextBlock Text="CHLL Seeder" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Top"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="SeedNavItem" Content="Seed" Tag="seed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Launch" Tag="launch">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Ranks" Tag="leaderboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tools" Tag="tools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- In-app toast stack: overlays the content, anchored bottom. -->
        <ItemsControl
            x:Name="ToastHost"
            Grid.Row="1"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Stretch"
            Margin="12,0,12,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="services:InAppToast">
                    <InfoBar
                        IsOpen="True"
                        IsClosable="True"
                        Margin="0,6,0,0"
                        Severity="{x:Bind Severity}"
                        Message="{x:Bind Message}"
                        Closed="Toast_Closed" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- First-run onboarding overlay: covers the shell (rows 0+1) until completed/skipped.
             Visibility is driven from code-behind (x:Bind isn't supported on a Window root). -->
        <views:OnboardingView
            x:Name="Onboarding"
            Grid.Row="0"
            Grid.RowSpan="2" />
    </Grid>
</Window>
